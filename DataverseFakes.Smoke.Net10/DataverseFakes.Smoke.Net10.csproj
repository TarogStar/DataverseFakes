<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net10 type-identity smoke test. Intentionally NOT added to DataverseFakes.sln:
    it must consume the net10.0 asset of the multi-target DataverseFakes in isolation
    (against Microsoft.PowerPlatform.Dataverse.Client) to prove assembly identity.
    It is built and run by its own CI step in .github/workflows/ci.yml, not by the
    solution build. Run locally with:
      dotnet test DataverseFakes.Smoke.Net10\DataverseFakes.Smoke.Net10.csproj -c Release
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataverseFakes\DataverseFakes.csproj" />
  </ItemGroup>

</Project>
