<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net10.0</TargetFrameworks>
    <AssemblyName>DataverseFakes</AssemblyName>
    <RootNamespace>DataverseFakes</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Strong naming -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>fakexrmeasy.snk</AssemblyOriginatorKeyFile>

    <!-- NuGet package metadata -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>DataverseFakes.Community</PackageId>
    <Version>1.2.0</Version>
    <Authors>DataverseFakes Community Contributors</Authors>
    <Company>DataverseFakes Community</Company>
    <Product>DataverseFakes Community Edition</Product>
    <Description>A modern, open-source unit testing framework for Dynamics 365 / Dataverse. Mock IOrganizationService with an in-memory context for fast plugin, workflow, and custom code testing. Supports 62+ SDK messages, FetchXML, QueryExpression, pipeline simulation, and more.</Description>
    <PackageProjectUrl>https://github.com/TarogStar/DataverseFakes</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TarogStar/DataverseFakes.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>Dynamics365 CRM CommonDataService PowerPlatform UnitTesting Mocking Testing Plugins Workflows DataverseFakes Dataverse Community OpenSource</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright © DataverseFakes Community Contributors</Copyright>

    <!-- Build settings -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>TRACE;DEBUG;FAKE_XRM_EASY_9</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE;FAKE_XRM_EASY_9</DefineConstants>
  </PropertyGroup>

  <!-- net462: legacy CRM SDK -->
  <ItemGroup Condition="'$(TargetFramework)'=='net462'">
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
    <PackageReference Include="Microsoft.CrmSdk.Workflow" Version="9.0.2.60" />
    <PackageReference Include="Microsoft.CrmSdk.XrmTooling.CoreAssembly" Version="9.1.1.65" />
    <PackageReference Include="Microsoft.CrmSdk.Deployment" Version="9.0.2.34" />
  </ItemGroup>

  <!-- net10: cross-platform Dataverse SDK (bundles modern Microsoft.Xrm.Sdk + Microsoft.Crm.Sdk.Proxy) -->
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.10" />
  </ItemGroup>

  <!-- both legs -->
  <ItemGroup>
    <PackageReference Include="FakeItEasy" Version="8.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.2" PrivateAssets="all" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" PrivateAssets="all" />
    <!-- Pin patched version to override the vulnerable 8.0.2 pulled transitively by System.ServiceModel.* (NU1903: GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf) -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net462'">
    <!-- net462 GAC assemblies actually used by the compiled source:
         System.Activities      -> WorkflowInvoker/CodeActivity (XrmFakedContext.CodeActivities.cs)
         System.Configuration   -> ConfigurationManager (XrmRealContext.cs)
         System.Runtime.Serialization -> [DataContract]/[DataMember] + DataContractSerializer
         System.ServiceModel    -> FaultException -->
    <Reference Include="System.Activities" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include SNK file -->
    <None Include="fakexrmeasy.snk" />

    <!-- Include README in NuGet package -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Import Project="..\DataverseFakes.Shared\DataverseFakes.Shared.projitems" Label="Shared" />

  <!-- FW-only files: excluded on net10. MUST be after the projitems Import (items must exist before Remove). -->
  <ItemGroup Condition="'$(TargetFramework)'!='net462'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\DataverseFakes.Shared\XrmFakedContext.CodeActivities.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\DataverseFakes.Shared\XrmFakedWorkflowContext.cs" />
  </ItemGroup>

</Project>
