<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>DataverseFakes.Tests</AssemblyName>
    <RootNamespace>DataverseFakes.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>

    <!-- Build settings -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UserSecretsId>52306faf-85ce-4d22-a7b8-3e872eeee272</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>TRACE;DEBUG;FAKE_XRM_EASY_9</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE;FAKE_XRM_EASY_9</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit test framework. Versions centralized in Directory.Packages.props. -->
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- User Secrets for secure configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />

    <!-- Dynamics 365 SDK (matching main project versions) -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" />
    <PackageReference Include="Microsoft.CrmSdk.Workflow" />
    <PackageReference Include="Microsoft.CrmSdk.XrmTooling.CoreAssembly" />
    <PackageReference Include="Microsoft.CrmSdk.Deployment" />

    <!-- Mocking framework -->
    <PackageReference Include="FakeItEasy" />
  </ItemGroup>

  <ItemGroup>
    <!-- Framework references -->
    <Reference Include="System.Activities" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.DirectoryServices" />
    <Reference Include="System.DirectoryServices.AccountManagement" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Workflow.Activities" />
    <Reference Include="System.Workflow.ComponentModel" />
    <Reference Include="System.Workflow.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project reference to main library -->
    <ProjectReference Include="..\DataverseFakes\DataverseFakes.csproj" />
  </ItemGroup>

  <Import Project="..\DataverseFakes.Tests.Shared\DataverseFakes.Tests.Shared.projitems" Label="Shared" />

</Project>
